---
import SectionHeading from './SectionHeading.astro';
import { experience, education } from '../data/portfolio';
---

<section id="experiencia" class="scroll-mt-20 py-24">
	<div class="mx-auto max-w-6xl px-6">
		<SectionHeading
			kicker="Trayectoria"
			title="Experiencia & educación"
			subtitle="Lo que he construido y lo que estoy estudiando."
		/>

		<div class="grid gap-10 lg:grid-cols-5">
			<div class="lg:col-span-3">
				<h3 class="mb-6 flex items-center gap-2 text-sm font-semibold uppercase tracking-widest text-zinc-400">
					Experiencia laboral
				</h3>
				<ol class="relative space-y-8 border-l border-white/10 pl-8">
					{
						experience.map((job) => (
							<li class="relative">
								<span class="absolute -left-[41px] top-1.5 h-3 w-3 rounded-full border-2 border-brand-400 bg-zinc-950" />
								<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
									<h4 class="text-lg font-semibold text-white">{job.role}</h4>
									<span class="rounded-full border border-brand-500/30 bg-brand-500/10 px-2.5 py-0.5 text-xs font-medium text-brand-300">
										{job.period}
									</span>
								</div>
								<p class="mt-1 text-sm font-medium text-zinc-400">{job.company}</p>
								<ul class="mt-3 space-y-2">
									{job.bullets.map((bullet) => (
										<li class="flex gap-2.5 text-sm leading-relaxed text-zinc-400">
											<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-400/70" />
											{bullet}
										</li>
									))}
								</ul>
							</li>
						))
					}
				</ol>
			</div>

			<div class="lg:col-span-2">
				<h3 class="mb-6 flex items-center gap-2 text-sm font-semibold uppercase tracking-widest text-zinc-400">
					Educación
				</h3>
				<div class="space-y-5">
					{
						education.map((item) => (
							<div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6 transition hover:border-brand-500/30">
								<span class="inline-block rounded-full bg-brand-500/15 px-3 py-1 text-xs font-semibold text-brand-300">
									{item.status}
								</span>
								<h4 class="mt-4 text-lg font-semibold leading-snug text-white">{item.degree}</h4>
								<p class="mt-1.5 text-sm text-zinc-400">{item.school}</p>
								<p class="mt-3 text-xs font-medium uppercase tracking-wider text-zinc-500">
									{item.period}
								</p>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
