---
const links = [
	{ href: '#inicio', label: 'Inicio' },
	{ href: '#sobre-mi', label: 'Sobre mí' },
	{ href: '#experiencia', label: 'Experiencia' },
	{ href: '#proyectos', label: 'Proyectos' },
	{ href: '#habilidades', label: 'Habilidades' },
	{ href: '#contacto', label: 'Contacto' },
];
---

<header
	class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-zinc-950/70 backdrop-blur-xl"
>
	<nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
		<a href="#inicio" class="text-lg font-bold tracking-tight text-white">
			valeria<span class="text-brand-400">.campos</span>
		</a>

		<ul class="hidden items-center gap-1 md:flex">
			{
				links.map((link) => (
					<li>
						<a
							href={link.href}
							class="rounded-full px-4 py-2 text-sm font-medium text-zinc-400 transition hover:bg-white/5 hover:text-white"
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>

		<a
			href="#contacto"
			class="hidden rounded-full bg-brand-500 px-5 py-2 text-sm font-semibold text-white transition hover:bg-brand-400 md:inline-block"
		>
			¡Hablemos!
		</a>

		<button
			id="menu-toggle"
			aria-label="Abrir menú"
			class="rounded-lg p-2 text-zinc-400 transition hover:bg-white/5 hover:text-white md:hidden"
		>
			<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
		</button>
	</nav>

	<div id="mobile-menu" class="hidden border-t border-white/5 px-6 py-4 md:hidden">
		<ul class="flex flex-col gap-1">
			{
				links.map((link) => (
					<li>
						<a href={link.href} class="block rounded-lg px-4 py-3 text-sm font-medium text-zinc-300 hover:bg-white/5">
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');

	toggle?.addEventListener('click', () => {
		menu?.classList.toggle('hidden');
	});

	menu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => menu.classList.add('hidden'));
	});
</script>
