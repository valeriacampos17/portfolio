---
import { profile, socials } from '../data/portfolio';

const visibleSocials = socials.filter((social) => social.url);
---

<section id="inicio" class="relative flex min-h-screen items-center pt-16">
	<div class="mx-auto w-full max-w-6xl px-6 py-24">
		<p class="animate-fade-up mb-4 inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-4 py-1.5 text-sm font-medium text-brand-300">
			<span class="relative flex h-2 w-2">
				<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-400 opacity-75"></span>
				<span class="relative inline-flex h-2 w-2 rounded-full bg-brand-400"></span>
			</span>
			{profile.status}
		</p>

		<h1
			class="animate-fade-up animate-delay-100 mt-6 max-w-3xl text-4xl font-extrabold tracking-tight text-white sm:text-6xl lg:text-7xl"
		>
			{profile.firstName}
			<span class="block bg-gradient-to-r from-brand-400 via-fuchsia-400 to-brand-300 bg-clip-text text-transparent">
				{profile.role}
			</span>
		</h1>

		<p class="animate-fade-up animate-delay-200 mt-6 max-w-2xl text-lg leading-relaxed text-zinc-400">
			{profile.tagline}
		</p>

		<div class="animate-fade-up animate-delay-300 mt-10 flex flex-wrap items-center gap-4">
			<a
				href="#proyectos"
				class="rounded-full bg-brand-500 px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/25 transition hover:bg-brand-400 hover:shadow-brand-400/30"
			>
				Ver proyectos
			</a>
			<a
				href="#contacto"
				class="rounded-full border border-white/10 bg-white/5 px-7 py-3 text-sm font-semibold text-zinc-200 transition hover:border-white/20 hover:bg-white/10"
			>
				Contactar
			</a>
		</div>

		<div class="animate-fade-up animate-delay-400 mt-12 flex items-center gap-4">
			{
				visibleSocials.map((social) => (
					<a
						href={social.url}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={social.name}
						class="rounded-full border border-white/10 bg-white/5 p-3 text-zinc-400 transition hover:border-brand-500/40 hover:text-brand-300"
					>
						{social.icon === 'github' && (
							<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.56 22.29 24 17.79 24 12.5 24 5.87 18.63.5 12 .5z" />
							</svg>
						)}
						{social.icon === 'linkedin' && (
							<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
							</svg>
						)}
						{social.icon === 'whatsapp' && (
							<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 448 512">
								<path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" />
							</svg>
						)}
						{social.icon === 'mail' && (
							<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z" />
							</svg>
						)}
					</a>
				))
			}
		</div>
	</div>

	<a
		href="#sobre-mi"
		aria-label="Bajar a la siguiente sección"
		class="absolute bottom-8 left-1/2 -translate-x-1/2 text-zinc-500 transition hover:text-brand-300"
	>
		<svg class="h-6 w-6 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
		</svg>
	</a>
</section>
