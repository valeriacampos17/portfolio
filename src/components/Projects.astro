---
import SectionHeading from './SectionHeading.astro';
import { projects } from '../data/portfolio';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="proyectos" class="scroll-mt-20 py-24">
	<div class="mx-auto max-w-6xl px-6">
		<SectionHeading
			kicker="Proyectos"
			title="Proyectos destacados"
			subtitle="Mis trabajos representativos, de izquierda a derecha: deslizá o usá las flechas para verlos todos."
		/>

		<div class="relative">
			<button
				type="button"
				id="carousel-prev"
				aria-label="Proyecto anterior"
				class="absolute left-2 top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-zinc-900/80 text-zinc-300 backdrop-blur-sm transition hover:border-brand-500/40 hover:text-white disabled:cursor-not-allowed disabled:opacity-30 sm:flex"
			>
				<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
				</svg>
			</button>

			<div
				id="carousel-track"
				role="region"
				aria-label="Carrusel de proyectos destacados"
				tabindex="0"
				class="no-scrollbar flex snap-x snap-mandatory gap-6 overflow-x-auto pb-2"
			>
			{
				projects.map((project) => (
					<article class="group relative flex w-[86%] shrink-0 snap-start flex-col overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] transition duration-300 hover:-translate-y-1 hover:border-brand-500/40 hover:bg-white/[0.05] sm:w-[58%] lg:w-[46%]">
						<div class="relative aspect-video overflow-hidden bg-zinc-900">
							{project.coverStyle === 'mobile' ? (
								<>
									<div class="absolute inset-0 bg-gradient-to-br from-brand-700/40 via-zinc-950 to-fuchsia-900/30" />
									<div class="relative flex h-full items-center justify-center p-4">
										<img
											src={`${base}/${project.image}`}
											alt={project.imageAlt ?? project.title}
											loading="lazy"
											class="max-h-full w-auto rounded-2xl border-2 border-white/15 shadow-2xl transition duration-500 group-hover:-translate-y-1.5"
										/>
									</div>
								</>
							) : project.image ? (
								<>
									<img
										src={`${base}/${project.image}`}
										alt={project.imageAlt ?? project.title}
										loading="lazy"
										width="1280"
										height="720"
										class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-105"
									/>
									<div class="absolute inset-0 bg-gradient-to-t from-zinc-950/70 via-transparent to-transparent" />
								</>
							) : (
								<div class="flex h-full w-full flex-col items-center justify-center gap-3 bg-gradient-to-br from-brand-700/40 via-zinc-900 to-fuchsia-900/30">
									<svg class="h-12 w-12 text-brand-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
									</svg>
									<p class="px-6 text-center text-sm font-semibold text-zinc-300">{project.subtitle}</p>
								</div>
							)}
							{project.insetImage && (
								<img
									src={`${base}/${project.insetImage}`}
									alt=""
									loading="lazy"
									class="absolute bottom-4 right-4 hidden w-24 rounded-lg border-2 border-white/15 shadow-2xl transition duration-500 group-hover:-translate-y-1 sm:block md:w-28"
								/>
							)}
						</div>

						<div class="flex flex-1 flex-col p-7">
							<div class="flex flex-wrap items-center gap-2">
								<span class="rounded-full bg-brand-500/15 px-3 py-1 text-xs font-semibold text-brand-300">
									{project.subtitle}
								</span>
								{
									project.highlights?.map((highlight) => (
										<span class="text-xs font-medium text-zinc-500">· {highlight}</span>
									))
								}
							</div>

							<h3 class="mt-4 text-2xl font-bold text-white">{project.title}</h3>
							<p class="mt-3 flex-1 leading-relaxed text-zinc-400">{project.description}</p>

							<div class="mt-6 flex flex-wrap gap-2">
								{project.tech.map((tech) => (
									<span class="rounded-lg border border-white/10 bg-white/5 px-2.5 py-1 text-xs font-medium text-zinc-300">
										{tech}
									</span>
								))}
							</div>

							<div class="mt-6 flex items-center gap-5 border-t border-white/5 pt-5 text-sm font-medium">
								{project.link && (
									<a
										href={project.link}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-1.5 text-brand-300 transition hover:text-brand-200"
									>
										Demo en vivo
										<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
											<path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
										</svg>
									</a>
								)}
								{project.repo && (
									<a
										href={project.repo}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-1.5 text-zinc-400 transition hover:text-white"
									>
										<svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
											<path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.56 22.29 24 17.79 24 12.5 24 5.87 18.63.5 12 .5z" />
										</svg>
										Código
									</a>
								)}
							</div>
						</div>
					</article>
				))
			}
			</div>

			<button
				type="button"
				id="carousel-next"
				aria-label="Proyecto siguiente"
				class="absolute right-2 top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-zinc-900/80 text-zinc-300 backdrop-blur-sm transition hover:border-brand-500/40 hover:text-white disabled:cursor-not-allowed disabled:opacity-30 sm:flex"
			>
				<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
				</svg>
			</button>
		</div>

		<div id="carousel-dots" class="mt-6 flex justify-center gap-1.5" aria-hidden="true"></div>
	</div>
</section>

<script>
	const track = document.getElementById('carousel-track');
	const prev = document.getElementById('carousel-prev');
	const next = document.getElementById('carousel-next');
	const dotsWrap = document.getElementById('carousel-dots');

	if (track && prev && next && dotsWrap) {
		const slides = Array.from(track.children) as HTMLElement[];

		const step = () => {
			const first = slides[0];
			if (!first) return 0;
			const gap = parseFloat(getComputedStyle(track).gap) || 0;
			return first.getBoundingClientRect().width + gap;
		};

		const scrollable = () => track.scrollWidth - track.clientWidth > 8;
		const atStart = () => track.scrollLeft <= 4;
		const atEnd = () => track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;

		const dots = slides.map((_, index) => {
			const dot = document.createElement('button');
			dot.type = 'button';
			dot.className =
				'h-2 w-2 rounded-full bg-white/25 transition-all duration-300 hover:bg-white/50';
			dot.setAttribute('aria-label', `Ir al proyecto ${index + 1}`);
			dot.addEventListener('click', () => {
				track.scrollTo({ left: index * step(), behavior: 'smooth' });
			});
			dotsWrap.appendChild(dot);
			return dot;
		});

		const update = () => {
			const hasScroll = scrollable();
			prev.classList.toggle('invisible', !hasScroll);
			next.classList.toggle('invisible', !hasScroll);
			dotsWrap.classList.toggle('invisible', !hasScroll || slides.length < 2);
			prev.toggleAttribute('disabled', atStart());
			next.toggleAttribute('disabled', atEnd());

			const index = Math.min(
				slides.length - 1,
				Math.max(0, Math.round(track.scrollLeft / (step() || 1))),
			);
			dots.forEach((dot, i) => {
				const active = i === index;
				dot.classList.toggle('w-4', active);
				dot.classList.toggle('bg-white/80', active);
				dot.classList.toggle('w-2', !active);
				dot.classList.toggle('bg-white/25', !active);
			});
		};

		const move = (direction: 1 | -1) => {
			track.scrollBy({ left: direction * step(), behavior: 'smooth' });
		};

		prev.addEventListener('click', () => move(-1));
		next.addEventListener('click', () => move(1));

		let frame = 0;
		track.addEventListener('scroll', () => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(update);
		});
		window.addEventListener('resize', update);

		update();
	}
</script>
