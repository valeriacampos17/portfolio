---
interface Props {
	id?: string;
	kicker?: string;
	title: string;
	subtitle?: string;
}

const { id, kicker, title, subtitle } = Astro.props;
---

<header class="mb-12 max-w-2xl">
	{
		kicker && (
			<p class="mb-3 text-sm font-semibold uppercase tracking-widest text-brand-400">{kicker}</p>
		)
	}
	<h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h2>
	{subtitle && <p class="mt-4 text-lg leading-relaxed text-zinc-400">{subtitle}</p>}
</header>
