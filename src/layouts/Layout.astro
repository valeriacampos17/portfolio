---
import '../styles/global.css';
import { profile } from '../data/portfolio';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = `${profile.shortName} — ${profile.role}`,
	description = `${profile.shortName}, estudiante de Ingeniería de Sistemas y desarrolladora frontend con Angular, Tailwind CSS y consumo de REST APIs. La Victoria, Aragua.`,
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content={profile.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="min-h-screen">
		<div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
			<div
				class="absolute -top-40 left-1/2 h-[32rem] w-[32rem] -translate-x-1/2 rounded-full bg-brand-600/20 blur-3xl"
			>
			</div>
			<div class="absolute top-1/3 -left-40 h-96 w-96 rounded-full bg-fuchsia-600/10 blur-3xl"></div>
		</div>
		<slot />
	</body>
</html>
